# Copy this file to .env.docker before running Docker Compose.
# Do not commit .env.docker. Ask the project owner for the shared values through
# a private password manager or direct message.
PORT=3001
NODE_ENV=production
MONGODB_URI=replace-with-the-shared-mongodb-connection-string
JWT_SECRET=replace-with-the-shared-development-jwt-secret
JWT_EXPIRES_IN_SECONDS=900
REFRESH_TOKEN_EXPIRES_IN_DAYS=7
RESET_TOKEN_EXPIRES_IN_MINUTES=30
WEB_URL=http://localhost
CORS_ALLOWED_ORIGINS=http://localhost,http://localhost:80,http://localhost:4200,http://localhost:3001
TRUST_PROXY=true

# Optional integrations. Leave blank until configured for the team.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
PAYWAY_MERCHANT_ID=
PAYWAY_API_KEY=
PAYWAY_BASE_URL=https://checkout-sandbox.payway.com.kh
PAYWAY_CALLBACK_URL=
