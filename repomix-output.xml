<file path="apps/web/src/app/components/shared/authentication/auth-layout/auth-layout.css">
:host {
  display: block;
  min-height: 100dvh;
}

.auth-page {
  min-height: 100dvh;
  display: grid;
  grid-template-columns: minmax(320px, 0.88fr) minmax(480px, 1.12fr);
  background: var(--paper);
}

/* A flat colour rather than a shop photo, deliberately: a single craft-store
   image overclaims "artisan boutique" when the marketplace actually spans
   food, groceries, electronics, beauty — everything Khmer households shop
   for. The diagonal weave (four thin line layers, no image asset) gives the
   panel texture without picking one category to represent all of them. */
.story-panel {
  position: relative;
  overflow: hidden;
  min-height: 100dvh;
  display: flex;
  flex-direction: column;
  padding: clamp(2rem, 4vw, 3.5rem);
  color: #fff8ec;
  background:
    repeating-linear-gradient(45deg, rgba(255, 248, 236, 0.055) 0 1px, transparent 1px 46px),
    repeating-linear-gradient(-45deg, rgba(255, 248, 236, 0.055) 0 1px, transparent 1px 46px),
    linear-gradient(165deg, #8a3323 0%, #6f2519 46%, #4a170f 100%);
}

.story-panel::before {
  content: '';
  position: absolute;
  inset: 0;
  background: radial-gradient(120% 90% at 12% 8%, rgba(0, 0, 0, 0) 0%, rgba(0, 0, 0, .3) 100%);
  pointer-events: none;
}

.brand,
.mobile-brand {
  display: inline-flex;
  align-items: center;
  gap: 0.75rem;
  color: inherit;
  font-family: var(--font-display);
  font-size: 1.25rem;
  font-weight: 650;
  letter-spacing: -0.02em;
  text-decoration: none;
  position: relative;
  z-index: 2;
}

.brand-mark {
  width: 2.75rem;
  height: 2.75rem;
  display: grid;
  place-items: center;
  border-radius: 0.75rem;
  color: #f0c778;
  background: rgba(0, 0, 0, .18);
  border: 1px solid rgba(255, 250, 240, 0.22);
  backdrop-filter: blur(10px);
}

.brand-mark svg {
  width: 1.8rem;
  fill: none;
  stroke: currentColor;
  stroke-width: 1.8;
  stroke-linejoin: round;
}

.story-copy {
  position: relative;
  z-index: 1;
  margin: auto 0 2.25rem;
  max-width: 25rem;
}

.story-kicker,
.eyebrow {
  display: inline-block;
  color: #f0ca80;
  font-size: 0.66rem;
  font-weight: 800;
  letter-spacing: 0.16em;
  text-transform: uppercase;
}

.story-copy h2 {
  color: #fff8ec;
  max-width: 22rem;
  margin: .9rem 0 1rem;
  font-family: var(--font-display);
  font-size: clamp(2.25rem, 3.4vw, 3.3rem);
  font-weight: 580;
  line-height: 1.01;
  letter-spacing: -0.038em;
  text-wrap: balance;
}

.story-copy p {
  max-width: 24rem;
  margin: 0;
  color: rgba(255, 248, 236, 0.78);
  font-size: 0.88rem;
  line-height: 1.65;
}

.weave {
  display: flex;
  gap: 0.45rem;
  margin-bottom: .9rem;
  position: relative;
  z-index: 2;
}

.weave span {
  width: 2rem;
  height: 0.22rem;
  border-radius: 1rem;
  background: var(--gold);
}

.weave span:nth-child(even) {
  opacity: 0.45;
}

.story-footer {
  margin: 0;
  color: rgba(255, 248, 236, 0.64);
  font-size: 0.7rem;
  letter-spacing: .015em;
  position: relative;
  z-index: 2;
}

.form-panel {
  min-height: 100dvh;
  display: grid;
  place-items: center;
  /* Vertical padding tracks viewport height so the tallest form (register)
     still fits on a short laptop screen without the page scrolling. */
  padding: clamp(1.25rem, 4vh, 3rem) clamp(1.5rem, 5vw, 5rem);
}

.form-wrap {
  width: min(100%, 30rem);
}

.heading {
  margin-bottom: clamp(1rem, 2.4vh, 1.6rem);
}

.heading h1 {
  margin: 0.45rem 0 0.55rem;
  color: var(--ink);
  font-family: var(--font-display);
  font-size: clamp(1.85rem, 2.5vw, 2.4rem);
  font-weight: 650;
  line-height: 1.08;
  letter-spacing: -0.04em;
}

.heading p {
  /* Reserve two lines on every screen. Login's subtitle wraps to one line and
     register's to two, so without this the form below them starts at a
     different height and the page appears to jump when switching. */
  min-height: 3.2em;
  margin: 0;
  color: var(--muted);
  font-size: 0.95rem;
  line-height: 1.6;
}

.mobile-brand {
  display: none;
  color: var(--red);
}

.admin-theme .story-panel {
  background:
    linear-gradient(145deg, rgba(22, 28, 33, 0.95), rgba(44, 54, 58, 0.96)),
    #1c2428;
}

.admin-theme .eyebrow {
  color: #8a5a3c;
}

/* Short windows — a small laptop, or a browser with several toolbars open.
   Trade some of the heading's presence for fit, so the longest form still
   never scrolls. */
@media (max-height: 700px) {
  .form-panel {
    padding-block: 1rem;
  }

  .heading h1 {
    font-size: clamp(1.55rem, 2vw, 1.85rem);
  }

  .heading p {
    font-size: 0.9rem;
  }
}

@media (max-width: 800px) {
  .auth-page {
    grid-template-columns: 1fr;
  }

  .story-panel {
    display: none;
  }

  .form-panel {
    display: block;
    padding: 1.5rem;
  }

  .mobile-brand {
    display: inline-flex;
    margin-bottom: clamp(1.25rem, 4vh, 2.25rem);
  }

  .mobile-brand .brand-mark {
    color: var(--red);
    border-color: rgba(123, 42, 27, 0.15);
    background: rgba(123, 42, 27, 0.06);
  }

  .form-wrap {
    margin: 0 auto;
  }
}
