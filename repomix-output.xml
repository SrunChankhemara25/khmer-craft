<file path="apps/web/src/app/admin/admin-theme.scss">
.admin {
  --bg:#f6f7f8; --surface:#ffffff; --ink:#1f2429; --muted:#68707a;
  --line:#e6e8eb; --line-2:#d7dbdf; --gray:#f1f2f4;
  --accent:#8a1e2c; --accent-2:#711723; --accent-050:#f8eef0;
  --green:#1a7a4a; --green-050:#e9f5ee;
  --amber:#96660f; --amber-050:#fbf3e1;
  --red:#bb3434; --red-050:#fbeded;
  --r:10px; --shadow:0 1px 2px rgb(16 20 24/.06),0 3px 10px rgb(16 20 24/.04);
  --font:'Inter',system-ui,-apple-system,'Segoe UI',sans-serif;

  display:flex; min-height:100vh; background:var(--bg); color:var(--ink);
  font:400 13.5px/1.5 var(--font);

  /* shell */
  .sidebar{width:240px;flex-shrink:0;position:sticky;top:0;height:100vh;overflow-y:auto;
    background:var(--surface);border-right:1px solid var(--line);padding:18px 12px;display:flex;flex-direction:column}
  .brand{display:flex;align-items:center;gap:9px;padding:2px 10px 14px;font-weight:700;font-size:15px}
  .brand .logo{width:26px;height:26px;border-radius:7px;background:var(--accent);color:#fff;display:grid;place-items:center}
  .brand small{font-weight:600;color:var(--muted);background:var(--gray);border-radius:5px;padding:1px 6px;font-size:10.5px}
  .nav-group{margin-top:14px}
  .nav-label{font-size:10.5px;font-weight:600;letter-spacing:.08em;text-transform:uppercase;color:var(--muted);padding:0 10px;margin-bottom:4px}
  .nav a{display:flex;align-items:center;gap:9px;padding:7px 10px;margin:1px 0;border-radius:8px;
    color:var(--muted);text-decoration:none;font-weight:500;transition:background .15s,color .15s}
  .nav a:hover{background:var(--gray);color:var(--ink)}
  .nav a.active{background:var(--accent-050);color:var(--accent)}
  .nav-count{margin-left:auto;background:var(--accent);color:#fff;font-size:10.5px;font-weight:600;border-radius:99px;padding:0 6px}
  .sidebar-foot{margin-top:auto;padding:12px 6px 0;border-top:1px solid var(--line)}
  .foot-user{display:flex;align-items:center;gap:10px}

  .main{flex:1;min-width:0;display:flex;flex-direction:column}
  .topbar{position:sticky;top:0;z-index:20;height:56px;display:flex;align-items:center;gap:12px;
    padding:0 26px;background:var(--surface);border-bottom:1px solid var(--line)}
  .spacer{flex:1}
  .icon-btn{position:relative;width:34px;height:34px;border-radius:8px;border:1px solid var(--line);background:var(--surface);
    display:inline-grid;place-items:center;color:var(--muted);cursor:pointer;text-decoration:none;transition:.15s;flex-shrink:0}
  .icon-btn:hover{color:var(--ink);border-color:var(--line-2);background:var(--gray)}
  .dot{position:absolute;top:7px;right:8px;width:6px;height:6px;border-radius:50%;background:var(--accent)}
  .who{display:flex;align-items:center;gap:8px;font-weight:500}
  .avatar{width:28px;height:28px;border-radius:50%;background:var(--accent-050);color:var(--accent);
    display:grid;place-items:center;font-size:11px;font-weight:700;flex-shrink:0}
  .content{padding:26px;max-width:1320px;width:100%;margin:0 auto}

  /* honesty ribbon: admin datasets are local samples until the API exists */
  .demo-ribbon{display:flex;align-items:center;gap:8px;padding:8px 26px;background:var(--amber-050);
    color:var(--amber);font-size:12px;font-weight:600;border-bottom:1px solid var(--line)}

  /* search */
  .search-wrap{position:relative;width:340px}
  .search-box{display:flex;align-items:center;gap:8px;border:1px solid var(--line);border-radius:8px;
    background:var(--bg);padding:7px 10px;color:var(--muted)}
  .search-box input{border:0;outline:0;background:transparent;width:100%;font:inherit;color:var(--ink)}
  .results{position:absolute;top:42px;left:0;right:0;background:var(--surface);border:1px solid var(--line);
    border-radius:10px;box-shadow:var(--shadow);overflow:hidden;z-index:30;animation:pop .13s ease}
  .result{display:flex;gap:10px;align-items:center;padding:9px 12px;cursor:pointer}
  .result:hover{background:var(--gray)}
  .result .kind{margin-left:auto;font-size:11px;color:var(--muted)}

  /* page */
  .page-head{display:flex;align-items:flex-end;justify-content:space-between;gap:14px;margin-bottom:20px;animation:rise .3s ease both}
  .page-title{margin:0;font-size:20px;font-weight:650;letter-spacing:-.01em}
  .page-sub{margin:3px 0 0;color:var(--muted)}
  .toolbar{display:flex;align-items:center;gap:10px;flex-wrap:wrap;margin-bottom:14px}
  .toolbar .grow{flex:1}

  .card{background:var(--surface);border:1px solid var(--line);border-radius:var(--r);box-shadow:var(--shadow)}
  .card-pad{padding:18px}
  .card-head{display:flex;align-items:center;justify-content:space-between;gap:10px;padding:14px 18px;border-bottom:1px solid var(--line)}
  .card-title{margin:0;font-size:13px;font-weight:600}

  .grid{display:grid;gap:14px}
  .grid>*{animation:rise .3s ease both}
  .grid>*:nth-child(2){animation-delay:.05s}
  .grid>*:nth-child(3){animation-delay:.1s}
  .grid>*:nth-child(4){animation-delay:.15s}
  .stats{grid-template-columns:repeat(4,1fr)}
  .duo{grid-template-columns:1.5fr 1fr}
  .half{grid-template-columns:1fr 1fr}
  .g3{grid-template-columns:repeat(3,1fr)}
  .mb{margin-bottom:14px}

  .stat{padding:14px 16px}
  .stat .label{display:flex;align-items:center;gap:7px;color:var(--muted);font-size:12px;font-weight:500}
  .stat .value{font-size:21px;font-weight:650;letter-spacing:-.02em;margin-top:2px}
  .stat .hint{font-size:11.5px;color:var(--muted)}

  /* table */
  .tbl{width:100%;border-collapse:collapse}
  .tbl th{font-size:10.5px;font-weight:600;letter-spacing:.07em;text-transform:uppercase;color:var(--muted);
    text-align:left;padding:9px 16px;border-bottom:1px solid var(--line);background:var(--gray)}
  .tbl td{padding:10px 16px;border-bottom:1px solid var(--line);vertical-align:middle}
  .tbl tbody tr:last-child td{border-bottom:0}
  .tbl tbody tr{transition:background .12s}
  .tbl tbody tr:hover{background:#fafafa}
  .tbl .num{text-align:right;font-variant-numeric:tabular-nums}
  .tbl td.right{white-space:nowrap}
  .cell-actions{display:flex;gap:6px;justify-content:flex-end;align-items:center;white-space:nowrap}
  .tbl .icon-btn{width:30px;height:30px;border-radius:7px}
  .cell-main{font-weight:550}
  .cell-sub{color:var(--muted);font-size:12px}
  .thumb{width:32px;height:32px;border-radius:8px;background:var(--accent-050);color:var(--accent);
    display:inline-grid;place-items:center;font-size:11px;font-weight:700;flex-shrink:0}
  .cell-flex{display:flex;align-items:center;gap:10px}

  /* badges / buttons / inputs */
  .badge{display:inline-flex;align-items:center;border-radius:99px;padding:2px 9px;font-size:11px;font-weight:600;white-space:nowrap}
  .t-green{background:var(--green-050);color:var(--green)}
  .t-amber{background:var(--amber-050);color:var(--amber)}
  .t-red{background:var(--red-050);color:var(--red)}
  .t-gray{background:var(--gray);color:var(--muted)}

  .btn{display:inline-flex;align-items:center;gap:6px;border-radius:8px;border:1px solid var(--line);
    background:var(--surface);color:var(--ink);font:500 12.5px var(--font);padding:7px 12px;cursor:pointer;transition:.15s}
  .btn:hover{border-color:var(--line-2);background:var(--gray)}
  .btn:disabled{opacity:.5;cursor:not-allowed}
  .btn-primary{background:var(--accent);border-color:var(--accent);color:#fff}
  .btn-primary:hover{background:var(--accent-2);border-color:var(--accent-2)}
  .btn-sm{padding:4px 10px;font-size:12px}
  .btn-danger{color:var(--red)}
  .btn-danger:hover{background:var(--red-050);border-color:transparent}
  .link{border:0;background:none;color:var(--accent);font:500 12.5px var(--font);cursor:pointer;padding:0}
  .link:hover{text-decoration:underline}

  .input{border:1px solid var(--line);border-radius:8px;background:var(--surface);padding:7px 10px;
    font:inherit;color:var(--ink);outline:none;transition:border-color .15s}
  .input:focus{border-color:var(--accent)}
  .input-search{width:220px}
  select.input{cursor:pointer}

  .tabs{display:flex;gap:4px;background:var(--gray);border-radius:9px;padding:3px;width:max-content}
  .tab{border:0;background:transparent;border-radius:7px;padding:5px 12px;font:500 12.5px var(--font);color:var(--muted);cursor:pointer;transition:.15s}
  .tab.active{background:var(--surface);color:var(--ink);box-shadow:var(--shadow)}

  /* tooltips */
  [data-tip]{position:relative}
  [data-tip]:hover::after{content:attr(data-tip);position:absolute;bottom:calc(100% + 6px);left:50%;transform:translateX(-50%);
    background:var(--ink);color:#fff;font-size:11px;font-weight:500;padding:4px 8px;border-radius:6px;white-space:nowrap;
    z-index:70;pointer-events:none;animation:fade .15s ease}

  /* kebab menu */
  .menu-wrap{position:relative;display:inline-block}
  .menu-back{position:fixed;inset:0;z-index:35;border:0;background:transparent;cursor:default}
  .menu{position:absolute;right:0;top:calc(100% + 4px);min-width:180px;background:var(--surface);border:1px solid var(--line);
    border-radius:10px;box-shadow:0 10px 28px rgb(16 20 24/.14);padding:4px;z-index:36;animation:pop .13s ease}
  .menu-item{display:flex;align-items:center;gap:9px;width:100%;text-align:left;border:0;background:none;
    padding:8px 10px;border-radius:7px;font:500 12.5px var(--font);color:var(--ink);cursor:pointer;transition:.12s}
  .menu-item:hover{background:var(--gray)}
  .menu-item.danger{color:var(--red)}
  .menu-item.danger:hover{background:var(--red-050)}

  /* charts */
  .bars{display:flex;gap:10px;padding:16px 16px 10px}
  .bar-col{flex:1;display:flex;flex-direction:column;gap:6px}
  .bar-wrap{height:150px;display:flex;align-items:flex-end;justify-content:center}
  .bar{width:70%;max-width:34px;background:var(--accent);border-radius:5px 5px 0 0;transform-origin:bottom;animation:grow .5s ease}
  .bar-lbl{font-size:10.5px;color:var(--muted);text-align:center}
  .chart{padding:14px 16px 10px}
  .chart svg{width:100%;height:160px;display:block}
  .chart-x{display:flex;justify-content:space-between;font-size:10.5px;color:var(--muted);padding-top:6px}

  /* modal / drawer / toast / skeleton */
  .modal-back{position:fixed;inset:0;background:rgb(15 18 22/.35);z-index:60;display:grid;place-items:center;padding:16px;animation:fade .15s ease}
  .modal{width:440px;max-width:100%;background:var(--surface);border-radius:12px;border:1px solid var(--line);
    box-shadow:0 20px 50px rgb(16 20 24/.18);padding:20px;animation:pop .16s ease}
  .modal h3{margin:0 0 6px;font-size:15px;font-weight:650}
  .modal p{margin:0 0 16px;color:var(--muted)}
  .modal-actions{display:flex;justify-content:flex-end;gap:8px}
  .form-row{margin-bottom:12px}
  .form-row label{display:block;font-size:12px;font-weight:550;margin-bottom:5px}
  .form-row .input{width:100%}

  .drawer-back{position:fixed;inset:0;background:rgb(15 18 22/.3);z-index:50;animation:fade .15s ease}
  .drawer{position:fixed;top:0;right:0;bottom:0;width:480px;max-width:94vw;background:var(--surface);
    border-left:1px solid var(--line);z-index:51;display:flex;flex-direction:column;animation:slideL .2s ease}
  .drawer-head{display:flex;align-items:center;justify-content:space-between;gap:10px;padding:16px 20px;border-bottom:1px solid var(--line)}
  .drawer-body{padding:20px;overflow-y:auto}
  .kv{display:flex;justify-content:space-between;gap:12px;padding:7px 0;border-bottom:1px solid var(--line);font-size:13px}
  .kv:last-child{border-bottom:0}
  .kv .k{color:var(--muted)}
  .sect{font-size:11px;font-weight:650;letter-spacing:.07em;text-transform:uppercase;color:var(--muted);margin:18px 0 8px}

  .switch{position:relative;width:36px;height:20px;border-radius:99px;background:var(--line-2);cursor:pointer;transition:.15s;flex-shrink:0}
  .switch::after{content:'';position:absolute;top:2px;left:2px;width:16px;height:16px;border-radius:50%;background:#fff;transition:.15s}
  .switch.on{background:var(--accent)}
  .switch.on::after{left:18px}
  .set-row{display:flex;align-items:center;justify-content:space-between;gap:16px;padding:11px 0;border-bottom:1px solid var(--line)}
  .set-row:last-child{border-bottom:0}
  .set-row .t{font-weight:550}
  .set-row .d{color:var(--muted);font-size:12px}

  .toast{position:fixed;bottom:22px;left:50%;transform:translateX(-50%);background:var(--ink);color:#fff;
    border-radius:9px;padding:9px 16px;font-size:12.5px;font-weight:500;z-index:99;box-shadow:var(--shadow);animation:rise .2s ease}

  .skel{border-radius:var(--r);border:1px solid var(--line);background:var(--surface);overflow:hidden;animation:rise .3s ease both}
  .skel::after{content:'';display:block;height:100%;background:linear-gradient(90deg,transparent,var(--gray),transparent);animation:shimmer 1.1s infinite}

  .muted{color:var(--muted)} .right{text-align:right} .nowrap{white-space:nowrap}
  .empty{padding:28px;text-align:center;color:var(--muted)}
  .stars{color:var(--amber);letter-spacing:2px;font-size:12px}
  .list-item{display:flex;gap:10px;padding:9px 0;border-bottom:1px solid var(--line)}
  .list-item:last-child{border-bottom:0}
  .pulse-dot{width:7px;height:7px;border-radius:50%;background:var(--accent);margin-top:6px;flex-shrink:0}

  /* accessibility: visible keyboard focus everywhere in the admin */
  :focus-visible{outline:2px solid var(--accent);outline-offset:2px}

  @keyframes rise{from{opacity:0;transform:translateY(6px)}to{opacity:1;transform:none}}
  @keyframes pop{from{opacity:0;transform:scale(.96)}to{opacity:1;transform:scale(1)}}
  @keyframes slideL{from{transform:translateX(24px);opacity:0}to{transform:none;opacity:1}}
  @keyframes fade{from{opacity:0}to{opacity:1}}
  @keyframes grow{from{transform:scaleY(0)}}
  @keyframes shimmer{from{transform:translateX(-100%)}to{transform:translateX(100%)}}

  /* accessibility: honour the OS reduced-motion setting */
  @media (prefers-reduced-motion: reduce){
    .admin, .admin *{animation-duration:.01ms!important;animation-iteration-count:1!important;transition-duration:.01ms!important}
  }

  @media (max-width:1100px){ .stats{grid-template-columns:repeat(2,1fr)} .g3,.duo,.half{grid-template-columns:1fr} }
  @media (max-width:900px){
    .sidebar{width:60px;padding:18px 8px}
    .nav-label,.nav .txt,.nav-count,.brand-txt,.brand small,.sidebar-foot .cell-sub{display:none}
    .nav a{justify-content:center} .search-wrap{width:auto;flex:1}
    .demo-ribbon{padding:8px 16px}
  }
}
</file>

