<file path="apps/web/src/app/features/seller/faq/seller-faq.ts">
import { Component, inject, signal } from '@angular/core';
import { Router, RouterLink } from '@angular/router';
import { KcIcon } from '../../../components/shared/ui/kc-icon/kc-icon';
import { ScrollReveal } from '../../../components/shared/ui/scroll-reveal/scroll-reveal.directive';
import { SellerPortalHeader } from '../shared/seller-portal-header';
import { SellerFooter } from '../shared/seller-footer';
import { faqItems, sellerSteps } from '../../../core/data/seller-content.data';

@Component({
  selector: 'app-seller-faq',
  imports: [RouterLink, KcIcon, ScrollReveal, SellerPortalHeader, SellerFooter],
  template: `
    <app-seller-portal-header />
    <main>
      <section class="intro">
        <div class="wrap">
          <p class="eyebrow">Questions before you start</p>
          <h1>Seller FAQ</h1>
          <p class="lead">Learn what to prepare before submitting your store. You can also read more about KhmerCraft.</p>
          <a routerLink="/about" class="text-link">About KhmerCraft <span aria-hidden="true">→</span></a>
        </div>
      </section>

      <section class="list-wrap">
        <div class="wrap faq-list">
          @for (faq of faqItems; track faq.question; let i = $index) {
            <article class="faq-item" [kcReveal]="i">
              <h3>
                <button type="button" (click)="toggleFaq(i)" [attr.aria-expanded]="openFaq() === i" [attr.aria-controls]="'faq-answer-' + i">
                  <span>{{ faq.question }}</span>
                  <span class="icon" aria-hidden="true">{{ openFaq() === i ? '−' : '+' }}</span>
                </button>
              </h3>
              <div class="faq-answer" [class.open]="openFaq() === i" [attr.aria-hidden]="openFaq() !== i" [id]="'faq-answer-' + i">
                <p>{{ faq.answer }}</p>
              </div>
            </article>
          }
        </div>
      </section>

      <section class="timeline-recap">
        <div class="wrap">
          <div class="recap-intro centered" [kcReveal]="0">
            <p class="eyebrow">Still deciding?</p>
            <h2>Here's the short version of what happens.</h2>
          </div>
          <ol class="recap-list">
            @for (step of steps; track step.number; let i = $index) {
              <li [kcReveal]="i + 1">
                <span class="recap-icon"><kc-icon [name]="step.icon" [size]="18" /></span>
                <div><strong>{{ step.title }}</strong><p>{{ step.description }}</p></div>
              </li>
            }
          </ol>
        </div>
      </section>

      <section class="closing">
        <div class="wrap closing-inner">
          <h2>Answered what you needed?</h2>
          <div class="closing-actions">
            <button class="button primary" type="button" (click)="startOnboarding()">Start selling <span aria-hidden="true">→</span></button>
            <a class="text-link" routerLink="/become-a-seller/pricing">Check pricing again <span aria-hidden="true">→</span></a>
          </div>
        </div>
      </section>
    </main>
    <app-seller-footer />
  `,
  styles: [`
    :host{display:block;background:#fcfaf5;color:#28231f;--green:#213b30;--clay:#9b3827;--line:#e4dbce}*{box-sizing:border-box}.wrap{width:min(760px,calc(100% - 48px));margin-inline:auto}
    .eyebrow{margin:0 0 16px;color:var(--clay);font-size:12px;font-weight:800;letter-spacing:.13em;text-transform:uppercase}
    .intro{padding:clamp(70px,9vw,105px) 0 30px;text-align:center}h1{margin:0 0 18px;font-family:var(--font-heading);font-size:clamp(38px,4.4vw,58px);font-weight:500;letter-spacing:-.04em}.lead{margin:0 auto 22px;max-width:480px;color:#655d54;font-size:clamp(16px,1.4vw,18px);line-height:1.65}
    .text-link{display:inline-flex;align-items:center;gap:8px;color:var(--green);font-size:13px;font-weight:750;text-decoration:none}.text-link span{transition:transform .25s ease}.text-link:hover span{transform:translateX(3px)}
    .list-wrap{padding:20px 0 clamp(90px,10vw,130px)}
    .faq-list{border-top:1px solid var(--line)}.faq-item{border-bottom:1px solid var(--line)}.faq-item h3{margin:0}
    .faq-item button{display:flex;justify-content:space-between;gap:20px;width:100%;padding:26px 4px;border:0;background:transparent;text-align:left;font-weight:750;font-size:16px;cursor:pointer;color:inherit}
    .faq-item .icon{flex:none;color:var(--clay);font-size:18px}
    .faq-answer{display:grid;grid-template-rows:0fr;transition:grid-template-rows .3s ease}.faq-answer.open{grid-template-rows:1fr}
    .faq-answer p{min-height:0;overflow:hidden;margin:0;padding:0 4px;color:#6f665c;font-size:14px;line-height:1.7}
    .faq-answer.open p{padding-bottom:26px}
    a:focus-visible,button:focus-visible{outline:3px solid #bd8a42;outline-offset:4px}
    .timeline-recap{padding:clamp(60px,8vw,90px) 0;background:#f3eee5}.recap-intro.centered{max-width:520px;margin:0 auto 40px;text-align:center}.recap-intro h2{font-family:var(--font-heading);font-size:clamp(24px,2.8vw,34px);font-weight:500;letter-spacing:-.03em;margin:0}
    .recap-list{margin:0;padding:0;list-style:none;display:grid;gap:16px}.recap-list li{display:flex;gap:16px;align-items:flex-start;padding:18px 20px;background:#fff;border:1px solid #ddd3c2;border-radius:10px}.recap-icon{flex:none;display:grid;place-items:center;width:38px;height:38px;border-radius:50%;background:var(--green);color:#fff}.recap-list strong{display:block;font-size:14px;margin-bottom:4px}.recap-list p{margin:0;color:#6e655c;font-size:12.5px;line-height:1.55}
    .closing{padding:clamp(60px,8vw,90px) 0;text-align:center}.closing h2{font-family:var(--font-heading);font-size:clamp(24px,2.8vw,34px);font-weight:500;letter-spacing:-.03em;margin:0 0 22px}.closing-actions{display:flex;align-items:center;justify-content:center;gap:24px;flex-wrap:wrap}
    .button{display:inline-flex;align-items:center;justify-content:center;gap:22px;min-height:50px;padding:0 24px;border:0;border-radius:8px;font-weight:750;cursor:pointer;background:var(--green);color:#fff}
    .button span{transition:transform .25s ease}.button:hover span{transform:translateX(4px)}
    @media(max-width:600px){.recap-list li{padding:16px}}
    @media(prefers-reduced-motion:reduce){*,*::before,*::after{animation-duration:.01ms!important;animation-iteration-count:1!important;transition-duration:.01ms!important}}
  `],
})
export class SellerFaq {
  private readonly router = inject(Router);

  protected readonly faqItems = faqItems;
  protected readonly steps = sellerSteps;
  protected readonly openFaq = signal<number | null>(null);

  protected toggleFaq(index: number): void {
    this.openFaq.set(this.openFaq() === index ? null : index);
  }

  protected startOnboarding(): void {
    void this.router.navigateByUrl('/seller/onboarding');
  }
}
</file>

<file path="apps/web/src/app/features/seller/onboarding/seller-onboarding.css">
:host {
  --forest: #213c31;
  --forest-deep: #172c24;
  --clay: #9c3828;
  --clay-dark: #7f2d21;
  --cream: #f7f3ea;
  --paper: #fffdfa;
  --ink: #211d19;
  --muted: #756d62;
  --line: #ded5c5;
  --gold: #c4964b;
  display: block;
  min-height: 100vh;
  color: var(--ink);
  background: var(--cream);
}

* { box-sizing: border-box; }
button, input, select, textarea { font: inherit; }
button, a { -webkit-tap-highlight-color: transparent; }

.onboarding-shell { min-height: 100vh; }
.topbar {
  height: 68px;
  padding: 0 clamp(22px, 4vw, 64px);
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: rgba(255, 253, 250, .94);
  border-bottom: 1px solid rgba(53, 43, 34, .1);
  backdrop-filter: blur(16px);
}
.brand { display: inline-flex; align-items: center; gap: 10px; color: var(--ink); text-decoration: none; font: 700 24px/1 Georgia, serif; }
.brand-mark { width: 36px; height: 36px; display: grid; place-items: center; color: #fff; background: var(--clay); border-radius: 11px; }
.topbar-actions { display: flex; align-items: center; gap: 20px; }
.account-chip { display: inline-flex; align-items: center; gap: 7px; color: #5f574d; font-size: 13px; }
.exit-link { color: var(--clay); font-size: 13px; font-weight: 750; text-decoration: none; }
.progress-line { height: 3px; background: #e8e0d3; }
.progress-line span { display: block; height: 100%; background: var(--clay); transition: width .35s ease; }

.workspace { min-height: calc(100vh - 71px); display: grid; grid-template-columns: minmax(270px, 29vw) 1fr; }
.journey-panel {
  padding: clamp(38px, 5vw, 72px) clamp(28px, 4vw, 62px);
  display: flex;
  flex-direction: column;
  gap: 48px;
  color: #fff;
  background:
    radial-gradient(circle at 10% 90%, rgba(196,150,75,.18), transparent 32%),
    linear-gradient(145deg, var(--forest), var(--forest-deep));
}
.eyebrow, .step-kicker { margin: 0 0 12px; color: var(--gold); font-size: 11px; font-weight: 850; letter-spacing: .18em; text-transform: uppercase; }
.journey-panel h1 { max-width: 440px; margin: 0; font: 600 clamp(31px, 3.4vw, 53px)/1.05 Georgia, serif; letter-spacing: -.025em; }
.journey-copy { max-width: 430px; margin: 18px 0 0; color: rgba(255,255,255,.68); font-size: 14px; line-height: 1.7; }
.steps { display: grid; gap: 8px; }
.steps button { width: 100%; padding: 12px; display: flex; align-items: center; gap: 13px; color: rgba(255,255,255,.55); text-align: left; background: transparent; border: 0; border-radius: 12px; cursor: pointer; }
.steps button:disabled { cursor: default; }
.steps button.current { color: #fff; background: rgba(255,255,255,.09); }
.steps button.complete { color: rgba(255,255,255,.82); }
.step-number { width: 30px; height: 30px; flex: 0 0 30px; display: grid; place-items: center; border: 1px solid rgba(255,255,255,.24); border-radius: 50%; font-size: 12px; font-weight: 800; }
.current .step-number { color: var(--forest); background: #f0cf8c; border-color: #f0cf8c; }
.complete .step-number { color: #fff; background: rgba(255,255,255,.16); }
.steps strong, .steps small { display: block; }
.steps strong { font-size: 13px; }
.steps small { margin-top: 3px; color: inherit; font-size: 10px; opacity: .7; }
.account-note { margin-top: auto; padding: 16px; display: flex; gap: 11px; color: #eedaa8; background: rgba(255,255,255,.07); border: 1px solid rgba(255,255,255,.1); border-radius: 14px; }
.account-note p { margin: 0; }
.account-note strong, .account-note span { display: block; }
.account-note strong { font-size: 12px; }
.account-note span { margin-top: 4px; color: rgba(255,255,255,.58); font-size: 11px; line-height: 1.5; }

.form-panel { min-width: 0; padding: clamp(34px, 5vw, 70px) clamp(28px, 6vw, 88px) 30px; background: var(--paper); }
.step-content { width: min(100%, 1020px); margin: 0 auto; }
.step-content.compact { max-width: 760px; }
.section-heading { margin-bottom: 30px; }
.section-heading h2 { margin: 0; font: 600 clamp(29px, 3.1vw, 45px)/1.08 Georgia, serif; letter-spacing: -.025em; }
.section-heading > p:last-child { max-width: 650px; margin: 13px 0 0; color: var(--muted); font-size: 14px; line-height: 1.65; }
.draft-banner { width: min(100%, 1020px); margin: -16px auto 28px; padding: 12px 15px; display: flex; justify-content: space-between; gap: 18px; color: #455a4f; background: #edf3ed; border: 1px solid #d6e4d7; border-radius: 11px; font-size: 12px; }
.draft-banner span { display: flex; align-items: center; gap: 7px; }
.draft-banner button { color: var(--clay); font-weight: 800; background: none; border: 0; cursor: pointer; }

.form-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 21px; }
.field { min-width: 0; display: grid; gap: 8px; }
.field.full { grid-column: 1 / -1; }
.field > span:first-child { font-size: 12px; font-weight: 800; }
.field b { color: var(--clay); }
.field input, .field select, .field textarea { width: 100%; min-height: 50px; padding: 0 15px; color: var(--ink); background: #fff; border: 1px solid var(--line); border-radius: 10px; outline: 0; transition: border-color .2s, box-shadow .2s, background .2s; }
.field textarea { min-height: 230px; padding: 15px; resize: vertical; line-height: 1.6; }
.field input:focus, .field select:focus, .field textarea:focus { border-color: var(--clay); box-shadow: 0 0 0 3px rgba(156,56,40,.09); }
.field.invalid input, .field.invalid select, .field.invalid textarea, .field.invalid .input-with-prefix { border-color: #b83d31; }
.field small { color: #91877a; font-size: 10px; line-height: 1.4; }
.field small.error, .error { color: #a32f25; font-weight: 700; }
.input-with-prefix { display: flex; align-items: center; background: #fff; border: 1px solid var(--line); border-radius: 10px; transition: border-color .2s, box-shadow .2s; overflow: hidden; }
.input-with-prefix:focus-within { border-color: var(--clay); box-shadow: 0 0 0 3px rgba(156,56,40,.09); }
.input-with-prefix > span { padding-left: 15px; color: #746c62; font-size: 12px; white-space: nowrap; }
.input-with-prefix input { border: 0; box-shadow: none !important; }
.tip-card, .upload-note, .billing-truth { margin-top: 24px; padding: 14px 16px; display: flex; align-items: flex-start; gap: 11px; color: #6b5735; background: #faf2df; border: 1px solid #ebdcc0; border-radius: 12px; }
.tip-card p, .upload-note p, .billing-truth p { margin: 0; }
.tip-card strong, .tip-card span, .upload-note strong, .upload-note span, .billing-truth strong, .billing-truth span { display: block; }
.tip-card strong, .upload-note strong, .billing-truth strong { font-size: 12px; }
.tip-card span, .upload-note span, .billing-truth span { margin-top: 3px; color: #887b69; font-size: 11px; line-height: 1.5; }

.story-layout { display: grid; grid-template-columns: minmax(0, 1.15fr) minmax(250px, .85fr); gap: 30px; align-items: start; }
.field-meta { display: flex; justify-content: space-between; color: #91877a; font-size: 10px; }
.store-preview { overflow: hidden; background: #fff; border: 1px solid var(--line); border-radius: 16px; box-shadow: 0 18px 45px rgba(53,42,31,.08); }
.preview-cover { height: 112px; padding: 12px; display: flex; align-items: flex-end; justify-content: flex-end; color: rgba(255,255,255,.72); background: linear-gradient(135deg, #264b3b, #9b754c); font-size: 9px; text-transform: uppercase; letter-spacing: .12em; }
.preview-body { position: relative; padding: 38px 20px 20px; }
.preview-logo { position: absolute; top: -29px; left: 20px; width: 58px; height: 58px; display: grid; place-items: center; color: var(--clay); background: #fffaf1; border: 4px solid #fff; border-radius: 15px; box-shadow: 0 6px 15px rgba(0,0,0,.1); font: 700 19px Georgia, serif; }
.preview-category { color: var(--clay); font-size: 9px; font-weight: 850; letter-spacing: .12em; text-transform: uppercase; }
.preview-body h3 { margin: 6px 0 7px; font: 600 22px Georgia, serif; }
.preview-body p { min-height: 45px; margin: 0; display: -webkit-box; overflow: hidden; color: #766e64; font-size: 11px; line-height: 1.5; -webkit-line-clamp: 3; -webkit-box-orient: vertical; }
.preview-location { margin-top: 13px; display: flex; align-items: center; gap: 5px; color: #8a8175; font-size: 10px; }
.upload-note { background: #eff4f0; border-color: #d8e4da; color: #365345; }

.plan-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 15px; }
.plan-card { position: relative; min-height: 360px; padding: 20px; display: flex; flex-direction: column; color: var(--ink); text-align: left; background: #fff; border: 1px solid var(--line); border-radius: 16px; cursor: pointer; transition: transform .2s, border-color .2s, box-shadow .2s; }
.plan-card:hover { transform: translateY(-3px); box-shadow: 0 14px 32px rgba(60,44,31,.08); }
.plan-card.selected { border: 2px solid var(--forest); box-shadow: 0 14px 35px rgba(33,60,49,.11); }
.plan-select { height: 27px; display: flex; justify-content: space-between; align-items: center; }
.plan-select i { width: 17px; height: 17px; display: block; border: 1px solid #a89f92; border-radius: 50%; }
.selected .plan-select i { border: 5px solid var(--forest); }
.plan-select b { padding: 5px 8px; color: #fff; background: var(--clay); border-radius: 20px; font-size: 8px; letter-spacing: .05em; text-transform: uppercase; }
.plan-title { margin-top: 20px; font: 600 23px Georgia, serif; }
.plan-price { margin-top: 8px; display: flex; align-items: baseline; gap: 5px; }
.plan-price strong { font-size: 35px; line-height: 1; }
.plan-price small { color: var(--muted); font-size: 10px; }
.plan-description { min-height: 55px; margin-top: 12px; color: var(--muted); font-size: 11px; line-height: 1.55; }
.plan-divider { height: 1px; margin: 20px 0; background: #ece5da; }
.plan-features { display: grid; gap: 12px; color: #564f47; font-size: 11px; }
.plan-features > span { display: flex; gap: 7px; align-items: flex-start; }
.plan-features kc-icon { color: #4f765e; }

.review-layout { display: grid; grid-template-columns: minmax(0, 1fr) 270px; gap: 22px; align-items: start; }
.review-main { display: grid; gap: 12px; }
.review-card { padding: 18px; background: #fff; border: 1px solid var(--line); border-radius: 13px; }
.review-card header { display: flex; justify-content: space-between; align-items: center; font-size: 12px; font-weight: 850; }
.review-card header button { color: var(--clay); background: none; border: 0; font-size: 10px; font-weight: 850; cursor: pointer; }
.review-card dl { margin: 15px 0 0; display: grid; grid-template-columns: 1fr 1fr; gap: 12px 20px; }
.review-card dl div { min-width: 0; }
.review-card dt { color: #8b8277; font-size: 9px; text-transform: uppercase; letter-spacing: .08em; }
.review-card dd { margin: 4px 0 0; overflow-wrap: anywhere; font-size: 12px; font-weight: 650; }
.review-card > p { margin: 12px 0 0; color: #6f675e; font-size: 11px; line-height: 1.6; }
.chosen-plan { margin-top: 14px; padding: 13px; display: flex; justify-content: space-between; gap: 15px; background: #f6f2ea; border-radius: 10px; }
.chosen-plan span, .chosen-plan strong, .chosen-plan small { display: block; }
.chosen-plan strong { font-size: 13px; }
.chosen-plan small { margin-top: 3px; color: #82796d; font-size: 9px; font-weight: 400; }
.chosen-plan > b { font-size: 18px; }
.chosen-plan > b small { display: inline; }
.payment-row { margin-top: 13px; display: flex; align-items: center; gap: 10px; }
.payment-icon { width: 31px; height: 31px; display: grid; place-items: center; color: #fff; background: #4d765e; border-radius: 8px; }
.payment-icon.khqr { background: #1b4c8a; font-size: 9px; font-weight: 900; }
.payment-row p { margin: 0; }
.payment-row strong, .payment-row small { display: block; }
.payment-row strong { font-size: 11px; }
.payment-row small { margin-top: 3px; color: #857c70; font-size: 9px; }
.terms-check { padding: 8px 2px; display: flex; align-items: flex-start; gap: 9px; color: #665e55; font-size: 10px; cursor: pointer; }
.terms-check input { position: absolute; opacity: 0; pointer-events: none; }
.terms-check span { display: flex; align-items: center; gap: 8px; }
.terms-check i { width: 18px; height: 18px; flex: 0 0 18px; display: grid; place-items: center; color: transparent; background: #fff; border: 1px solid #b9afa2; border-radius: 5px; }
.terms-check input:checked + span i { color: #fff; background: var(--forest); border-color: var(--forest); }
.terms-check a { color: var(--clay); font-weight: 750; }
.terms-error { margin: -10px 0 4px 29px; }
.submit-error { padding: 12px; display: flex; gap: 8px; align-items: center; color: #8e2921; background: #fff0ee; border: 1px solid #f0c9c4; border-radius: 9px; font-size: 11px; font-weight: 700; }
.summary-card { position: sticky; top: 28px; padding: 22px; color: #fff; background: var(--forest); border-radius: 15px; box-shadow: 0 18px 40px rgba(26,50,40,.16); }
.summary-label { margin: 0; color: #cfb783; font-size: 9px; font-weight: 850; letter-spacing: .13em; text-transform: uppercase; }
.summary-card > strong { margin-top: 9px; display: block; font: 600 36px Georgia, serif; }
.summary-card > span { color: rgba(255,255,255,.65); font-size: 10px; }
.summary-card ul { margin: 20px 0; padding: 17px 0; display: grid; gap: 10px; list-style: none; border-block: 1px solid rgba(255,255,255,.13); }
.summary-card li { display: flex; align-items: center; gap: 7px; color: rgba(255,255,255,.77); font-size: 10px; }
.summary-card > small { display: block; margin-top: 10px; color: rgba(255,255,255,.48); font-size: 8px; text-align: center; }

.form-actions { width: min(100%, 1020px); margin: 34px auto 0; padding-top: 20px; display: flex; justify-content: space-between; border-top: 1px solid #eee7dc; }
.primary, .secondary, .back-button { min-height: 45px; padding: 0 19px; display: inline-flex; align-items: center; justify-content: center; gap: 16px; border-radius: 10px; font-size: 12px; font-weight: 850; text-decoration: none; cursor: pointer; transition: transform .2s, background .2s, box-shadow .2s; }
.primary { color: #fff; background: var(--clay); border: 1px solid var(--clay); box-shadow: 0 7px 18px rgba(156,56,40,.16); }
.primary:hover { background: var(--clay-dark); transform: translateY(-1px); }
.primary:disabled { opacity: .6; cursor: wait; transform: none; }
.primary.wide { width: 100%; }
.secondary { color: var(--ink); background: #fff; border: 1px solid var(--line); }
.back-button { padding-left: 0; color: #6f675e; background: transparent; border: 0; box-shadow: none; }

.success-screen { min-height: calc(100vh - 68px); padding: clamp(35px, 7vw, 95px); display: grid; grid-template-columns: minmax(0, 1.15fr) minmax(290px, .85fr); gap: clamp(30px, 7vw, 100px); align-items: center; background: var(--paper); }
.success-card { max-width: 680px; }
.success-mark { width: 68px; height: 68px; margin-bottom: 23px; display: grid; place-items: center; color: #fff; background: #4c765d; border-radius: 50%; box-shadow: 0 12px 28px rgba(76,118,93,.2); }
.success-card h1 { margin: 0; font: 600 clamp(38px, 5vw, 68px)/1.02 Georgia, serif; letter-spacing: -.035em; }
.success-card > p:not(.eyebrow) { max-width: 610px; margin: 18px 0 0; color: var(--muted); font-size: 14px; line-height: 1.7; }
.success-summary { margin-top: 28px; padding: 15px; display: flex; align-items: center; gap: 13px; background: var(--cream); border: 1px solid var(--line); border-radius: 13px; }
.success-logo { width: 44px; height: 44px; display: grid; place-items: center; color: var(--clay); background: #fff; border-radius: 11px; font: 700 15px Georgia, serif; }
.success-summary > span { flex: 1; }
.success-summary strong, .success-summary small { display: block; }
.success-summary strong { font-size: 13px; }
.success-summary small { margin-top: 3px; color: #81786d; font-size: 9px; }
.success-summary > b { padding: 6px 9px; color: #456452; background: #e5eee7; border-radius: 20px; font-size: 9px; }
.success-actions { margin-top: 23px; display: flex; gap: 10px; flex-wrap: wrap; }
.quiet-link { margin-top: 18px; display: inline-block; color: #776e63; font-size: 11px; }
.next-steps { padding: clamp(28px, 4vw, 52px); color: #fff; background: var(--forest); border-radius: 22px; }
.next-steps h2 { margin: 0; font: 600 30px/1.15 Georgia, serif; }
.next-steps ol { margin: 30px 0 0; padding: 0; display: grid; gap: 22px; list-style: none; }
.next-steps li { display: flex; gap: 15px; }
.next-steps li > span { color: #d9ba78; font: 600 15px Georgia, serif; }
.next-steps p { margin: 0; }
.next-steps strong, .next-steps small { display: block; }
.next-steps strong { font-size: 12px; }
.next-steps small { margin-top: 5px; color: rgba(255,255,255,.57); font-size: 10px; line-height: 1.5; }

@media (max-width: 960px) {
  .workspace { grid-template-columns: 1fr; }
  .journey-panel { padding: 32px clamp(22px, 6vw, 56px); gap: 26px; }
  .journey-panel h1 { font-size: 38px; }
  .journey-copy, .account-note { display: none; }
  .steps { grid-template-columns: repeat(4, 1fr); }
  .steps button { padding: 8px; }
  .steps small { display: none; }
  .form-panel { padding-top: 40px; }
  .success-screen { grid-template-columns: 1fr; }
  .next-steps { max-width: 680px; }
}

@media (max-width: 700px) {
  .topbar { height: 60px; padding: 0 16px; }
  .brand { font-size: 20px; }
  .brand-mark { width: 32px; height: 32px; }
  .account-chip { display: none; }
  .journey-panel { padding: 25px 16px 18px; }
  .journey-panel h1 { font-size: 31px; }
  .steps { gap: 3px; }
  .steps button { padding: 6px; justify-content: center; }
  .steps button > span:last-child { display: none; }
  .step-number { width: 28px; height: 28px; flex-basis: 28px; }
  .form-panel { padding: 31px 16px 22px; }
  .section-heading { margin-bottom: 24px; }
  .section-heading h2 { font-size: 31px; }
  .form-grid, .story-layout, .plan-grid, .review-layout { grid-template-columns: 1fr; }
  .field.full { grid-column: auto; }
  .field textarea { min-height: 170px; }
  .store-preview { max-width: 400px; }
  .plan-card { min-height: 0; }
  .summary-card { position: static; }
  .review-card dl { grid-template-columns: 1fr; }
  .form-actions { margin-top: 25px; }
  .draft-banner { margin-top: -10px; align-items: flex-start; }
  .draft-banner span { align-items: flex-start; }
  .success-screen { min-height: calc(100vh - 60px); padding: 38px 16px; gap: 35px; }
  .success-card h1 { font-size: 40px; }
  .success-summary { align-items: flex-start; flex-wrap: wrap; }
  .success-summary > b { margin-left: 57px; }
}

@media (prefers-reduced-motion: reduce) {
  *, *::before, *::after { scroll-behavior: auto !important; transition-duration: .01ms !important; }
}
