@import 'tailwindcss';
/* ============================================================
   KhmerCraft — Design System
   Minimal, content-first visual language inspired by Notion's
   calm neutral surfaces and Apple's precise type & motion.
   ============================================================ */

:root {
  /* Neutral surface scale (Notion-like warm grays) */
  --color-bg: #fffdf8;
  --color-bg-alt: #f6f1e7;
  --color-bg-hover: #eee7da;
  --color-surface: #fffefa;
  --color-surface-raised: #ffffff;

  /* Ink scale */
  --color-text: #241f19;
  --color-text-secondary: #514a41;
  --color-muted: #81786d;
  --color-muted-2: #aaa095;
  --color-border: #e8dfd1;
  --color-border-strong: #d8cdbd;

  /* Brand accent — restrained, used sparingly like a highlight not a wash */
  --color-accent: #8e3021;
  --color-accent-hover: #6e2419;
  --color-accent-soft: rgba(142, 48, 33, 0.08);
  --color-accent-soft-strong: rgba(142, 48, 33, 0.16);
  --color-gold: #a87522;
  --color-forest: #263c31;
  --color-sand: #d9bd8b;

  --color-danger: #d1453b;
  --color-danger-soft: rgba(209, 69, 59, 0.08);
  --color-success: #2f7a4f;
  --color-success-soft: rgba(47, 122, 79, 0.08);

  /* Radii */
  --radius-xs: 6px;
  --radius-sm: 8px;
  --radius-md: 12px;
  --radius-lg: 18px;
  --radius-xl: 26px;
  --radius-full: 999px;

  /* Elevation */
  --shadow-xs: 0 1px 2px rgba(15, 15, 15, 0.04);
  --shadow-sm: 0 3px 12px rgba(51, 38, 24, 0.07);
  --shadow-md: 0 14px 36px rgba(51, 38, 24, 0.10);
  --shadow-lg: 0 28px 70px rgba(51, 38, 24, 0.14);
  --shadow-focus: 0 0 0 4px var(--color-accent-soft-strong);

  /* Typography */
  --font-body: Inter, ui-sans-serif, -apple-system, BlinkMacSystemFont, 'SF Pro Text', 'Segoe UI', sans-serif;
  --font-heading: Georgia, 'Times New Roman', serif;

  /* Motion */
  --ease-standard: cubic-bezier(0.2, 0.8, 0.2, 1);
  --ease-out: cubic-bezier(0.16, 1, 0.3, 1);
  --ease-in-out: cubic-bezier(0.65, 0, 0.35, 1);
  --dur-fast: 120ms;
  --dur-base: 200ms;
  --dur-slow: 360ms;

  /* KhmerCraft brand aliases — the auth screens were built against these
     names; they now point at the same terracotta as --color-accent so the
     storefront and the sign-in flow cannot drift apart. */
  --red: #7b2a1b;
  --red-dark: #5f1f15;
  --gold: #e0b269;
  --paper: #fbf8f1;
  --surface: #fffdf8;
  --ink: #28231f;
  --muted: #756d64;
  --line: #ded7ca;
  --success: #2f694b;
  --error: #a12f2f;
  --font-display: Georgia, 'Times New Roman', serif;

  --header-h: 62px;
  --content-max: none;
  --page-gutter: clamp(16px, 2.4vw, 64px);
  --section-space: clamp(58px, 7vw, 112px);
}

* { box-sizing: border-box; }
*::selection { background: var(--color-accent-soft-strong); }

html { scroll-behavior: smooth; min-width: 320px; }

html, body {
  margin: 0;
  padding: 0;
  background: var(--color-bg);
  color: var(--color-text);
  font-family: var(--font-body);
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
  text-rendering: optimizeLegibility;
  font-size: clamp(15px, 0.22vw + 13px, 17px);
  letter-spacing: -0.006em;
  overflow-x: clip;
}

h1, h2, h3, h4, h5 {
  font-family: var(--font-heading);
  margin: 0;
  color: var(--color-text);
  font-weight: 600;
  letter-spacing: -0.028em;
  line-height: 1.12;
}

p { margin: 0; color: var(--color-text-secondary); }
a { text-decoration: none; color: inherit; transition: color var(--dur-fast) var(--ease-standard); }
button {
  font-family: var(--font-body);
  cursor: pointer;
  transition: transform var(--dur-fast) var(--ease-standard), background var(--dur-base) var(--ease-standard),
    border-color var(--dur-base) var(--ease-standard), color var(--dur-base) var(--ease-standard),
    box-shadow var(--dur-base) var(--ease-standard);
}
button:active { transform: scale(0.97); }
input, select, textarea {
  font-family: var(--font-body);
  color: var(--color-text);
  transition: border-color var(--dur-base) var(--ease-standard),
    box-shadow var(--dur-base) var(--ease-standard),
    transform var(--dur-base) var(--ease-standard);
}
input:focus, select:focus, textarea:focus {
  outline: none;
  border-color: var(--color-accent) !important;
  box-shadow: var(--shadow-focus);
  transform: translateY(-1px);
}
::placeholder { color: var(--color-muted-2); transition: color var(--dur-base) var(--ease-standard); }
input:focus::placeholder, textarea:focus::placeholder { color: var(--color-muted); }

/* A field's own validation message (e.g. `@if (invalid('email')) { <small>…`)
   — the field turning red and the reason appearing should read as one
   motion, not the border snapping red while the text pops in cold. */
label small, .field-error, .form-error {
  display: block;
  animation: fadeInUp var(--dur-base) var(--ease-out) both;
}

.container {
  /* 1240px left ~340px of dead margin either side on a 1920 screen. This
     scales with the viewport instead, while still stopping text lines from
     becoming uncomfortably long on very wide monitors. */
  width: 100%;
  max-width: var(--content-max);
  margin: 0 auto;
  padding-inline: var(--page-gutter);
}

@media (max-width: 900px) {
  .container { padding-inline: var(--page-gutter); }
}

/* ===== Buttons ===== */
.btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  min-height: 44px;
  padding: 11px 21px;
  border-radius: var(--radius-md);
  font-weight: 600;
  font-size: 14px;
  border: 1px solid transparent;
  white-space: nowrap;
  letter-spacing: -0.01em;
}
.btn-primary { background: var(--color-accent); color: #fff; }
.btn-primary:hover { background: var(--color-accent-hover); box-shadow: var(--shadow-sm); }
.btn-accent { background: var(--color-accent); color: #fff; }
.btn-accent:hover { background: var(--color-accent-hover); box-shadow: var(--shadow-sm); }
.btn-gold { background: var(--color-gold); color: #fff; }
.btn-gold:hover { background: #96702a; box-shadow: var(--shadow-sm); }
.btn-outline { background: transparent; border: 1px solid var(--color-border-strong); color: var(--color-text); }
.btn-outline:hover { background: var(--color-bg-alt); border-color: var(--color-muted); }
.btn-ghost { background: transparent; border: 1px solid transparent; color: var(--color-text-secondary); }
.btn-ghost:hover { background: var(--color-bg-alt); }
.btn-danger { background: var(--color-danger); color: #fff; }
.btn-danger:hover { background: #b83a31; }
.btn-block { width: 100%; }
.btn-lg { min-height: 52px; padding: 14px 27px; font-size: 15px; border-radius: 14px; }
.btn-sm { padding: 7px 14px; font-size: 13px; }
.btn:disabled { opacity: .5; cursor: not-allowed; }
.btn:disabled:active { transform: none; }

/* ===== Badges & chips ===== */
.badge {
  display: inline-flex;
  align-items: center;
  gap: 5px;
  padding: 4px 10px;
  border-radius: var(--radius-full);
  font-size: 11.5px;
  font-weight: 600;
  letter-spacing: 0.01em;
}
.badge-in-stock { background: var(--color-success-soft); color: var(--color-success); }
.badge-low-stock { background: rgba(184, 134, 42, 0.1); color: var(--color-gold); }
.badge-gold { background: rgba(184, 134, 42, 0.1); color: var(--color-gold); }
.badge-soft { background: var(--color-accent-soft); color: var(--color-accent); }
.badge-neutral { background: var(--color-bg-alt); color: var(--color-text-secondary); border: 1px solid var(--color-border); }

/* ===== Stars / rating ===== */
.stars { color: var(--color-gold); display: inline-flex; gap: 1px; }
.rating-row { display: flex; align-items: center; gap: 5px; font-size: 13px; color: var(--color-text); }
.rating-row .count { color: var(--color-muted); font-weight: 400; }

/* ===== Card ===== */
.card {
  background: var(--color-surface);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-lg);
  overflow: hidden;
  transition: border-color var(--dur-base) var(--ease-standard), box-shadow var(--dur-base) var(--ease-standard), transform var(--dur-base) var(--ease-standard);
}
.card-hover:hover { border-color: var(--color-border-strong); box-shadow: var(--shadow-md); transform: translateY(-4px); }

/* Placeholder image blocks */
.img-placeholder {
  position: relative;
  width: 100%;
  height: 100%;
  background:
    radial-gradient(circle at 18% 24%, rgba(217, 189, 139, .35), transparent 25%),
    radial-gradient(circle at 82% 72%, rgba(142, 48, 33, .12), transparent 30%),
    repeating-linear-gradient(135deg, rgba(80, 60, 35, .028) 0 1px, transparent 1px 16px),
    #f1ecdf;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--color-muted);
  font-size: 11.5px;
  font-weight: 600;
  letter-spacing: 0.02em;
  text-transform: uppercase;
  text-align: center;
  padding: 8px;
}
.img-placeholder.dark {
  background:
    linear-gradient(135deg, #262b21 0%, #1c1f18 55%, #14150f 100%),
    repeating-linear-gradient(135deg, rgba(255,255,255,0.025) 0 1px, transparent 1px 14px);
  color: rgba(255,255,255,0.45);
}

/* ===== Form fields ===== */
.field { display: flex; flex-direction: column; gap: 6px; }
.field label { font-size: 13px; font-weight: 600; color: var(--color-text-secondary); }
.field .hint { font-size: 12px; color: var(--color-muted); }
.field input, .field select {
  width: 100%;
  padding: 11px 14px;
  border: 1px solid var(--color-border-strong);
  border-radius: var(--radius-sm);
  font-size: 14px;
  background: var(--color-surface);
}
.field .input-icon-wrap { position: relative; }
.field .input-icon-wrap input { padding-left: 40px; }
.field .input-icon-wrap:has(.toggle-visibility) input { padding-right: 42px; }
.field .input-icon-wrap > ui-icon { position: absolute; left: 13px; top: 50%; transform: translateY(-50%); color: var(--color-muted); pointer-events: none; }
.field .input-icon-wrap .toggle-visibility {
  position: absolute; right: 8px; top: 50%; transform: translateY(-50%);
  background: none; border: none; color: var(--color-muted);
  width: 30px; height: 30px; border-radius: var(--radius-xs);
  display: flex; align-items: center; justify-content: center;
}
.field .input-icon-wrap .toggle-visibility:hover { color: var(--color-text); background: var(--color-bg-alt); }
.field-error { font-size: 12px; color: var(--color-danger); }
.field input.invalid { border-color: var(--color-danger); }

/* ===== Custom checkbox & radio ===== */
input[type="checkbox"], input[type="radio"] {
  appearance: none;
  -webkit-appearance: none;
  width: 17px;
  height: 17px;
  border: 1.5px solid var(--color-border-strong);
  background: var(--color-surface);
  display: inline-block;
  flex-shrink: 0;
  cursor: pointer;
  position: relative;
  transition: all var(--dur-fast) var(--ease-standard);
}
input[type="checkbox"] { border-radius: 5px; }
input[type="radio"] { border-radius: 50%; }
input[type="checkbox"]:hover, input[type="radio"]:hover { border-color: var(--color-accent); }
input[type="checkbox"]:checked, input[type="radio"]:checked {
  background: var(--color-accent);
  border-color: var(--color-accent);
}
input[type="checkbox"]:checked::after {
  content: '';
  position: absolute;
  left: 5px; top: 1.5px;
  width: 4px; height: 8px;
  border: solid #fff;
  border-width: 0 2px 2px 0;
  transform: rotate(45deg);
}
input[type="radio"]:checked::after {
  content: '';
  position: absolute;
  left: 50%; top: 50%;
  width: 7px; height: 7px;
  border-radius: 50%;
  background: #fff;
  transform: translate(-50%, -50%);
}
input[type="checkbox"]:focus-visible, input[type="radio"]:focus-visible {
  box-shadow: var(--shadow-focus);
}

/* ===== Motion utilities ===== */
@keyframes fadeInUp {
  from { opacity: 0; transform: translateY(10px); }
  to { opacity: 1; transform: translateY(0); }
}
@keyframes fadeIn {
  from { opacity: 0; }
  to { opacity: 1; }
}
@keyframes scaleIn {
  from { opacity: 0; transform: scale(0.96); }
  to { opacity: 1; transform: scale(1); }
}
.animate-in { animation: fadeInUp var(--dur-slow) var(--ease-out) both; }
.animate-fade { animation: fadeIn var(--dur-slow) var(--ease-out) both; }
.animate-scale { animation: scaleIn var(--dur-base) var(--ease-out) both; }
.delay-1 { animation-delay: 60ms; }
.delay-2 { animation-delay: 120ms; }
.delay-3 { animation-delay: 180ms; }
.delay-4 { animation-delay: 240ms; }

/* ===== Page transitions (Router withViewTransitions) =====
   The browser's View Transitions API snapshots the outgoing page and
   crossfades it with the incoming one; without this block that crossfade is
   a flat, instant-feeling opacity swap. Giving old/new their own timing plus
   a small rise/fall makes a route change read as one continuous motion
   rather than a page just replacing another. */
::view-transition-old(root) {
  animation: kc-page-out var(--dur-base) var(--ease-standard) both;
}
::view-transition-new(root) {
  animation: kc-page-in var(--dur-slow) var(--ease-out) both;
}
@keyframes kc-page-out {
  from { opacity: 1; transform: translateY(0); }
  to { opacity: 0; transform: translateY(-6px); }
}
@keyframes kc-page-in {
  from { opacity: 0; transform: translateY(10px); }
  to { opacity: 1; transform: translateY(0); }
}
@media (prefers-reduced-motion: reduce) {
  ::view-transition-group(root),
  ::view-transition-old(root),
  ::view-transition-new(root) {
    animation: none !important;
  }
}

/* ===== animate.enter / animate.leave utilities =====
   Paired with Angular's native `animate.enter="..."` / `animate.leave="..."`
   template bindings: `enter` runs once the element is in the DOM, `leave`
   runs before Angular actually removes it, so a drawer/menu/backdrop closes
   with the same motion it opened with instead of just vanishing. Reuse
   these rather than one-off animations per component so every popover in
   the app closes with the same feel. */
@keyframes kc-fade-in { from { opacity: 0; } to { opacity: 1; } }
@keyframes kc-fade-out { from { opacity: 1; } to { opacity: 0; } }
.kc-fade-enter { animation: kc-fade-in var(--dur-base) var(--ease-standard) both; }
.kc-fade-leave { animation: kc-fade-out var(--dur-base) var(--ease-standard) both; }

@keyframes kc-pop-in {
  from { opacity: 0; transform: scale(.94) translateY(-4px); }
  to { opacity: 1; transform: scale(1) translateY(0); }
}
@keyframes kc-pop-out {
  from { opacity: 1; transform: scale(1) translateY(0); }
  to { opacity: 0; transform: scale(.96) translateY(-4px); }
}
.kc-pop-enter { animation: kc-pop-in var(--dur-base) var(--ease-out) both; transform-origin: top; }
.kc-pop-leave { animation: kc-pop-out var(--dur-fast) var(--ease-standard) both; transform-origin: top; }

@keyframes kc-panel-in-right {
  from { opacity: .85; transform: translateX(100%); }
  to { opacity: 1; transform: translateX(0); }
}
@keyframes kc-panel-out-right {
  from { opacity: 1; transform: translateX(0); }
  to { opacity: .85; transform: translateX(100%); }
}
.kc-panel-enter-right { animation: kc-panel-in-right var(--dur-slow) cubic-bezier(.22,.85,.32,1) both; }
.kc-panel-leave-right { animation: kc-panel-out-right 260ms var(--ease-standard) both; }

@keyframes kc-panel-in-left {
  from { opacity: .85; transform: translateX(-100%); }
  to { opacity: 1; transform: translateX(0); }
}
@keyframes kc-panel-out-left {
  from { opacity: 1; transform: translateX(0); }
  to { opacity: .85; transform: translateX(-100%); }
}
.kc-panel-enter-left { animation: kc-panel-in-left var(--dur-slow) cubic-bezier(.22,.85,.32,1) both; }
.kc-panel-leave-left { animation: kc-panel-out-left 260ms var(--ease-standard) both; }

@media (prefers-reduced-motion: reduce) {
  .kc-fade-enter, .kc-fade-leave, .kc-pop-enter, .kc-pop-leave,
  .kc-panel-enter-right, .kc-panel-leave-right,
  .kc-panel-enter-left, .kc-panel-leave-left {
    animation-duration: 1ms !important;
  }
}

::-webkit-scrollbar { height: 8px; width: 8px; }
::-webkit-scrollbar-thumb { background: var(--color-border-strong); border-radius: 4px; }
::-webkit-scrollbar-thumb:hover { background: var(--color-muted-2); }

/* ============================================================
   Auth screens (login, register, password reset)
   ============================================================ */
* {
  box-sizing: border-box;
}

html,
body {
  min-height: 100%;
  margin: 0;
}

body {
  min-width: 320px;
  /* No background here: the storefront is white (--color-bg, set above) and
     the auth screens paint their own cream via .auth-page. Setting --paper
     globally would tint every storefront page. */
}

button,
input {
  font: inherit;
}

.auth-form {
  display: grid;
  gap: 1.05rem;
}

.auth-form.compact {
  gap: 0.8rem;
}

.auth-form label {
  display: grid;
  gap: 0.4rem;
  color: #403a35;
  font-size: 0.85rem;
  font-weight: 700;
}

.auth-form label em {
  margin-left: 0.35rem;
  color: #928a81;
  font-size: 0.72rem;
  font-style: normal;
  font-weight: 500;
}

.label-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 1rem;
}

.auth-form a,
.auth-switch a,
.admin-link {
  color: var(--red);
  font-weight: 700;
  text-decoration: none;
}

.auth-form a:hover,
.auth-switch a:hover,
.admin-link:hover {
  text-decoration: underline;
  text-underline-offset: 0.22rem;
}

.auth-form input {
  width: 100%;
  height: 3rem;
  padding: 0 1rem;
  color: var(--ink);
  background: rgba(255, 253, 248, 0.78);
  border: 1px solid var(--line);
  border-radius: 0.65rem;
  outline: none;
  transition:
    border-color 160ms ease,
    box-shadow 160ms ease,
    background 160ms ease;
}

.auth-form input::placeholder {
  color: #a29a90;
}

.auth-form input:focus {
  background: #fff;
  border-color: var(--red);
  box-shadow: 0 0 0 3px rgba(123, 42, 27, 0.1);
}

.auth-form label:has(input.ng-invalid.ng-touched) input {
  border-color: var(--error);
}

.auth-tabs {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 0.35rem;
  margin-bottom: 1.1rem;
  padding: 0.3rem;
  background: rgba(255, 253, 248, 0.72);
  border: 1px solid var(--line);
  border-radius: 0.8rem;
}

.auth-tabs button {
  min-width: 0;
  min-height: 2.45rem;
  padding: 0.55rem 0.65rem;
  color: var(--muted);
  background: transparent;
  border: 0;
  border-radius: 0.58rem;
  font-size: 0.84rem;
  font-weight: 800;
}

.auth-tabs button.active {
  color: var(--red);
  background: #fff;
  box-shadow: var(--shadow-xs);
}

.admin-theme .auth-tabs button.active {
  color: #263238;
}

.password-field {
  position: relative;
}

.password-field input {
  padding-right: 3rem;
}

.password-toggle {
  position: absolute;
  top: 50%;
  right: 0.58rem;
  width: 2rem;
  height: 2rem;
  display: inline-grid;
  place-items: center;
  color: #8d857c;
  background: transparent;
  border: 0;
  border-radius: 0.5rem;
  transform: translateY(-50%);
}

.password-toggle:hover {
  color: var(--ink);
  background: rgba(123, 42, 27, 0.06);
}

.password-toggle:active {
  transform: translateY(-50%) scale(0.97);
}

.auth-form small {
  color: var(--error);
  font-size: 0.74rem;
  font-weight: 600;
}

/* .required rule removed per user request */

.primary-button {
  width: 100%;
  min-height: 3.1rem;
  display: inline-grid;
  place-items: center;
  margin-top: 0.25rem;
  padding: 0.75rem 1.25rem;
  color: #fffaf0;
  background: var(--red);
  border: 0;
  border-radius: 0.65rem;
  box-shadow: 0 0.7rem 1.5rem rgba(91, 31, 20, 0.14);
  cursor: pointer;
  font-weight: 800;
  text-align: center;
  text-decoration: none;
  transition:
    background 160ms ease,
    transform 160ms ease,
    box-shadow 160ms ease;
}

.primary-button:hover:not(:disabled) {
  background: var(--red-dark);
  box-shadow: 0 0.9rem 1.8rem rgba(91, 31, 20, 0.2);
  transform: translateY(-1px);
}

.primary-button:disabled {
  cursor: wait;
  opacity: 0.65;
}

.primary-button.admin-button {
  background: #263238;
}

.primary-button.admin-button:hover:not(:disabled) {
  background: #172126;
}

.button-link {
  margin-top: 1.25rem;
}

.text-button {
  padding: 0.4rem;
  color: var(--muted);
  background: transparent;
  border: 0;
  cursor: pointer;
  font-weight: 700;
}

.text-button:hover {
  color: var(--red);
}

.auth-switch {
  margin: 1.15rem 0 0;
  color: var(--muted);
  font-size: 0.88rem;
  text-align: center;
}

.admin-link {
  display: block;
  margin-top: 1rem;
  color: #797169;
  font-size: 0.76rem;
  text-align: center;
}

.notice {
  margin-bottom: 1rem;
  padding: 0.75rem 1rem;
  border: 1px solid;
  border-radius: 0.65rem;
  font-size: 0.82rem;
  font-weight: 650;
  line-height: 1.5;
}

.notice.success {
  color: var(--success);
  background: #eff7f1;
  border-color: #bcd7c5;
}

.notice.error {
  color: var(--error);
  background: #fff2f0;
  border-color: #ebc0bb;
}

@media (max-width: 480px) {
  .auth-form input {
    height: 2.85rem;
  }
}
