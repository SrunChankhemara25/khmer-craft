    @media (max-width: 980px) {
      .mission-grid, .timeline-section .timeline { grid-template-columns: 1fr; }
      .values-grid { grid-template-columns: repeat(auto-fill, minmax(230px, 1fr)); }
    }
  `]
})
export class AboutComponent {
