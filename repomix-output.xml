            linkRoute="/products"
          />
        </section>
      }
    } @else {
      <section class="container missing">
        <h1>Category not found</h1>
        <p>That category may have been renamed.</p>
        <button class="btn btn-primary" routerLink="/categories">
          All categories
        </button>
      </section>
    }

    <app-footer />
  `,
