      }
      .panel {
        display: grid;
        gap: 16px;
      }
      .block {
        padding: 20px 22px 22px;
      }
      .block h2 {
        display: flex;
        align-items: center;
        gap: 10px;
        font-size: 16px;
        margin-bottom: 16px;
      }
      .step {
        width: 22px;
        height: 22px;
        display: grid;
        place-items: center;
        border-radius: 50%;
        background: var(--color-accent);
        color: #fff;
        font-size: 12px;
      }
      .grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 14px;
