      }
      input[type='text'],
      input:not([type]) {
        width: 100%;
      }
      .grid input {
        height: 42px;
        padding: 0 12px;
        border: 1px solid var(--color-border-strong);
        border-radius: var(--radius-sm);
        font-size: 14px;
      }
