PORT=3001
MONGODB_URI=mongodb://127.0.0.1:27017/khmer-craft
# REQUIRED, minimum 32 characters. The API refuses to start without it, in
# every environment. Generate a unique value per environment:
#   openssl rand -hex 32
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN_SECONDS=900
REFRESH_TOKEN_EXPIRES_IN_DAYS=7
RESET_TOKEN_EXPIRES_IN_MINUTES=30

# Account lockout after repeated failed sign-ins
MAX_FAILED_LOGINS=5
ACCOUNT_LOCK_MINUTES=15
WEB_URL=http://localhost:4200
CORS_ALLOWED_ORIGINS=http://localhost:4200
TRUST_PROXY=false
# Public URL of this API. Google redirects here after the user approves
# sign-in; localhost is fine for development, but production needs HTTPS.
API_PUBLIC_URL=http://localhost:3001

# Transactional email: use your provider's authenticated SMTP credentials.
# Port 587 uses STARTTLS; port 465 uses TLS. Never commit real credentials.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
# For Gmail, create a 16-character App Password after enabling 2-Step
# Verification: https://myaccount.google.com/apppasswords
SMTP_PASSWORD=
MAIL_FROM=

# Google sign-in: create a Web application OAuth client in Google Cloud.
# Its authorized redirect URI must exactly match this value.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3001/auth/google/callback

# Telegram Login: create a bot with @BotFather, then open Login Widget to
# register this site's URL and obtain the Client ID and Client Secret.
TELEGRAM_CLIENT_ID=
TELEGRAM_CLIENT_SECRET=
TELEGRAM_OAUTH_REDIRECT_URI=http://localhost:3001/auth/telegram/callback

# ---------------------------------------------------------------- ABA PayWay
# From ABA's merchant/sandbox registration (sandbox.payway.com.kh). Leave unset
# and ABA_PAYWAY checkout returns a clear PAYWAY_NOT_CONFIGURED 500 — the rest
# of the API still runs. Never commit real values.
PAYWAY_MERCHANT_ID=
PAYWAY_API_KEY=
PAYWAY_BASE_URL=https://checkout-sandbox.payway.com.kh
# Publicly reachable webhook URL; a tunnel in dev. Optional — the payment page
# also polls ABA directly for the transaction status.
PAYWAY_CALLBACK_URL=
