{
  "installCommand": "npm ci && cd apps/api && npm ci && cd ../web && npm ci",
  "buildCommand": "cd apps/web && npm run build:deploy",
  "outputDirectory": "apps/web/dist/web/browser",
  "rewrites": [
    {
      "source": "/auth/:path*",
      "destination": "/api/auth/:path*"
    },
    {
      "source": "/:path*",
      "destination": "/index.html"
    }
  ]
}
